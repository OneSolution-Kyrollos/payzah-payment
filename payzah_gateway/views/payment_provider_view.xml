<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_provider_myfatoorah_form" model="ir.ui.view">
        <field name="name">payment.provider.myfatoorah.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='credentials']" position="inside">
                <group invisible="code != 'payzah'">
                    <field name="payzah_url_type"
                           string="Payment Page"
                           invisible="code != 'payzah'"/>
                    <field name="payzah_token"
                           string="Token"
                           required="code == 'payzah' and state != 'disabled'"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='state']" position="after">
                <field name="is_published"/>
            </xpath>
        </field>
    </record>
</odoo>
